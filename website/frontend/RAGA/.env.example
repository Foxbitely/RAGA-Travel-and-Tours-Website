# EmailJS — https://dashboard.emailjs.com
# Copy this file to .env and fill in the values. Vite only exposes
# variables prefixed with VITE_, and they are baked into the built
# bundle, so never put a private key or access token in here.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_BOOKING_TEMPLATE_ID=template_yyyyyyy
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
